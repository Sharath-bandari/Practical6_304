@model List<Practical6.Models.Products>

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Products Catalog</title>
</head>

<body>

    <h2>Products Catalog</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Description</th>
        </tr>

        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Category</td>
                <td>@product.Price</td>
                <td>@product.Description</td>
            </tr>
        }

    </table>

</body>
</html>
